# SQLite 数据库路径
DATABASE_URL="file:./dev.db"

# 会话签名密钥（请替换为随机长字符串，至少 32 字符）
SESSION_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# 首次创建管理员（仅 seed 时使用；不要提交真实密码）
BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
BOOTSTRAP_ADMIN_PASSWORD="replace-with-strong-password"
BOOTSTRAP_ADMIN_NAME="站点管理员"

# 接码服务商（真实接入前保持空；密钥仅服务端读取）
SMS_PROVIDER_API_URL=""
SMS_PROVIDER_API_KEY=""

# 支付服务商（真实接入前保持空；密钥仅服务端读取）
PAYMENT_PROVIDER=""
PAYMENT_API_KEY=""
PAYMENT_WEBHOOK_SECRET=""
